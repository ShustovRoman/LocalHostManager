<Window x:Class="LocalhostManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalhostManager"
        mc:Ignorable="d"
        Title="Localhost Manager" 
        Icon="Resources/app.ico"
        Height="620" Width="920"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- GridView Column Header Dark Style (No more ugly white bar) -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1D1D1D" />
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#1D1D1D" 
                                BorderBrush="#282828" 
                                BorderThickness="0,0,0,1" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar Styling for Windows 11 Dark -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Rectangle Fill="#383838" RadiusX="4" RadiusY="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu Dark Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Layout -->
        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Command Bar (Title & Search) -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Action Toolbar (Refresh, Filters, Pills) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Host Table / List -->
                <RowDefinition Height="*" />
                <!-- Row 3: Status bar / Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ROW 0: Header with App Branding, Language Selector & Search -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Minimalist Windows-style 2-color SVG Logo -->
                    <Border Width="30" Height="30" Background="#1F2A38" CornerRadius="7" Margin="0,0,10,0" BorderBrush="#2D4258" BorderThickness="1">
                        <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Windows Blue Accent Square -->
                            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="7" Height="7" Fill="#0078D4" RadiusX="1.5" RadiusY="1.5" />
                            <!-- Clean White Socket Squares -->
                            <Rectangle Canvas.Left="10" Canvas.Top="1" Width="7" Height="7" Fill="#E0E0E0" RadiusX="1.5" RadiusY="1.5" />
                            <Rectangle Canvas.Left="1" Canvas.Top="10" Width="7" Height="7" Fill="#E0E0E0" RadiusX="1.5" RadiusY="1.5" />
                            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="7" Height="7" Fill="#0078D4" RadiusX="1.5" RadiusY="1.5" />
                        </Canvas>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_AppTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF" />
                </StackPanel>

                <!-- Language Selector Dropdown (Fluent Dark) -->
                <ComboBox x:Name="LanguageComboBox" 
                          Grid.Column="2" 
                          Style="{StaticResource FluentComboBox}"
                          Height="32" 
                          Width="115"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Tag="ru" Content="Русский" IsSelected="True" />
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="es" Content="Español" />
                    <ComboBoxItem Tag="de" Content="Deutsch" />
                    <ComboBoxItem Tag="fr" Content="Français" />
                    <ComboBoxItem Tag="zh" Content="中文" />
                </ComboBox>

                <!-- Search Filter Box -->
                <Border Grid.Column="3" Background="#212121" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Height="32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Clean Vector Search Icon (No Emoji) -->
                        <Path Grid.Column="0" 
                              Data="M 7.5 3 C 5.01 3 3 5.01 3 7.5 C 3 9.99 5.01 12 7.5 12 C 8.6 12 9.61 11.6 10.38 10.94 L 13.72 14.28 C 13.92 14.48 14.24 14.48 14.44 14.28 C 14.64 14.08 14.64 13.76 14.44 13.56 L 11.1 10.22 C 11.66 9.47 12 8.53 12 7.5 C 12 5.01 9.99 3 7.5 3 Z M 7.5 4 C 9.43 4 11 5.57 11 7.5 C 11 9.43 9.43 11 7.5 11 C 5.57 11 4 9.43 4 7.5 C 4 5.57 5.57 4 7.5 4 Z" 
                              Fill="#707070" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" />

                        <!-- Search Input -->
                        <TextBox x:Name="SearchBox" Grid.Column="1" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#FFFFFF" 
                                 CaretBrush="#FFFFFF"
                                 VerticalAlignment="Center" 
                                 FontSize="13"
                                 TextChanged="SearchBox_TextChanged"/>

                        <!-- Placeholder -->
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" 
                                   Text="{DynamicResource Loc_SearchPlaceholder}" 
                                   Foreground="#666666" 
                                   VerticalAlignment="Center" 
                                   FontSize="13" 
                                   IsHitTestVisible="False"
                                   Visibility="Visible" />

                        <!-- Clear Button -->
                        <Button x:Name="ClearSearchButton" Grid.Column="2" 
                                Content="×" 
                                Width="24" Height="24" 
                                Margin="0,0,4,0"
                                Background="Transparent" 
                                Foreground="#888888" 
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="14"
                                Visibility="Collapsed"
                                Click="ClearSearchButton_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 1: Toolbar with Pills on Left and Refresh Button on Right -->
            <Border Grid.Row="1" Background="#1D1D1D" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Pills / Filter Badges -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- All Filter Pill -->
                        <RadioButton x:Name="PillAll" GroupName="CategoryFilter" 
                                     IsChecked="True" 
                                     Checked="FilterPill_Checked" 
                                     Cursor="Hand"
                                     Content="Все (0)"
                                     Margin="0,0,6,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="PillBorder" Background="#F25C3B" CornerRadius="14" Padding="12,5" SnapsToDevicePixels="True">
                                        <TextBlock x:Name="PillText" Text="{TemplateBinding Content}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="PillBorder" Property="Background" Value="#252525" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#AAAAAA" />
                                            <Setter TargetName="PillText" Property="FontWeight" Value="Normal" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="PillBorder" Property="Background" Value="#303030" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Dev Filter Pill -->
                        <RadioButton x:Name="PillDev" GroupName="CategoryFilter" 
                                     Checked="FilterPill_Checked" 
                                     Cursor="Hand"
                                     Content="Dev-хосты (0)"
                                     Margin="0,0,6,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="PillBorder" Background="#F25C3B" CornerRadius="14" Padding="12,5" SnapsToDevicePixels="True">
                                        <TextBlock x:Name="PillText" Text="{TemplateBinding Content}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="PillBorder" Property="Background" Value="#252525" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#AAAAAA" />
                                            <Setter TargetName="PillText" Property="FontWeight" Value="Normal" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="PillBorder" Property="Background" Value="#303030" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Database Filter Pill -->
                        <RadioButton x:Name="PillDb" GroupName="CategoryFilter" 
                                     Checked="FilterPill_Checked" 
                                     Cursor="Hand"
                                     Content="Базы данных (0)"
                                     Margin="0,0,6,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="PillBorder" Background="#F25C3B" CornerRadius="14" Padding="12,5" SnapsToDevicePixels="True">
                                        <TextBlock x:Name="PillText" Text="{TemplateBinding Content}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="PillBorder" Property="Background" Value="#252525" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#AAAAAA" />
                                            <Setter TargetName="PillText" Property="FontWeight" Value="Normal" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="PillBorder" Property="Background" Value="#303030" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- System Filter Pill -->
                        <RadioButton x:Name="PillSystem" GroupName="CategoryFilter" 
                                     Checked="FilterPill_Checked" 
                                     Cursor="Hand"
                                     Content="Системные (0)">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="PillBorder" Background="#F25C3B" CornerRadius="14" Padding="12,5" SnapsToDevicePixels="True">
                                        <TextBlock x:Name="PillText" Text="{TemplateBinding Content}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="PillBorder" Property="Background" Value="#252525" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#AAAAAA" />
                                            <Setter TargetName="PillText" Property="FontWeight" Value="Normal" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="PillBorder" Property="Background" Value="#303030" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>

                    <!-- Right: Refresh Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" 
                                Style="{StaticResource FluentPrimaryButton}" 
                                Click="RefreshButton_Click" 
                                ToolTip="{DynamicResource Loc_TooltipRefresh}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center" Foreground="#AAAAAA" />
                                <TextBlock Text="{DynamicResource Loc_Refresh}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 2: Host Table (ListView in Windows 11 Explorer Table Style) -->
            <Border Grid.Row="2" Background="#1D1D1D" BorderBrush="#282828" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Loc_EmptyTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Loc_EmptySubtitle}" FontSize="13" Foreground="#555555" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Table List -->
                    <ListView x:Name="PortsListView"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#FFFFFF"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              MouseDoubleClick="PortsListView_MouseDoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть в браузере" Click="MenuOpenBrowser_Click" FontWeight="SemiBold" />
                                <MenuItem Header="Копировать адрес URL" Click="MenuCopyUrl_Click" />
                                <MenuItem Header="Копировать PID" Click="MenuCopyPid_Click" />
                                <Separator Background="#333333" />
                                <MenuItem Header="Открыть папку с процессом" Click="MenuOpenFolder_Click" />
                                <Separator Background="#333333" />
                                <MenuItem Header="Завершить процесс" Click="MenuKillProcess_Click" Foreground="#F87171" />
                            </ContextMenu>
                        </ListView.ContextMenu>

                        <ListView.View>
                            <GridView x:Name="MainGridView">
                                <!-- Column 1: Port -->
                                <GridViewColumn Width="95">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="{DynamicResource Loc_ColPort}" FontWeight="SemiBold" Foreground="#8A8A8A" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding BadgeForeground}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Port}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Column 2: Category Badge -->
                                <GridViewColumn Width="115">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="{DynamicResource Loc_ColCategory}" FontWeight="SemiBold" Foreground="#8A8A8A" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BadgeBackground}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryDisplayName}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Column 3: Process Name & Path (Auto-stretched to fill space) -->
                                <GridViewColumn x:Name="ProcessColumn" Width="280">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="{DynamicResource Loc_ColProcess}" FontWeight="SemiBold" Foreground="#8A8A8A" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProcessPath}" FontSize="11" Foreground="#666666" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Column 4: PID -->
                                <GridViewColumn Width="80">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="{DynamicResource Loc_ColPid}" FontWeight="SemiBold" Foreground="#8A8A8A" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessId}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Column 5: Action Buttons (Right-aligned to table edge) -->
                                <GridViewColumn Width="140">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="{DynamicResource Loc_ColActions}" FontWeight="SemiBold" Foreground="#8A8A8A" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <!-- Open in Browser: Clean pure text, NO EMOJI, NO ARROW -->
                                                <Button Style="{StaticResource FluentOpenButton}" 
                                                        Click="OpenBrowserButton_Click" 
                                                        Margin="0,0,6,0"
                                                        ToolTip="{DynamicResource Loc_TooltipOpen}">
                                                    <TextBlock Text="{DynamicResource Loc_BtnOpen}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Button>

                                                <!-- Kill Process: Just sleek cross icon -->
                                                <Button Style="{StaticResource FluentDangerIconButton}" 
                                                        Click="KillProcessButton_Click"
                                                        ToolTip="{DynamicResource Loc_TooltipKill}">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#242424" />
                                <Setter Property="Padding" Value="6,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="true">
                                                <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="true">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!-- ROW 3: Status Bar / Footer -->
            <Grid Grid.Row="3" Margin="4,10,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status message -->
                <TextBlock x:Name="StatusMessageText" 
                           Text="Готово к работе" 
                           FontSize="12" 
                           Foreground="#777777" 
                           VerticalAlignment="Center" />

                <!-- Right: Hint & Shortcut -->
                <TextBlock Grid.Column="1" 
                           Text="{DynamicResource Loc_FooterHint}" 
                           FontSize="11" 
                           Foreground="#555555" 
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- IN-APP CONFIRMATION MODAL FOR SYSTEM PROCESSES (Windows 11 Fluent Card) -->
        <Grid x:Name="ConfirmationModal" Visibility="Collapsed" Background="#90000000">
            <Border Width="450" Background="#222222" BorderBrush="#383838" BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <!-- Warning Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="32" Height="32" Background="#3D1E1E" CornerRadius="6" Margin="0,0,12,0">
                            <!-- Clean Vector Exclamation Path -->
                            <Path Data="M 12 4 C 11.45 4 11 4.45 11 5 L 11 13 C 11 13.55 11.45 14 12 14 C 12.55 14 13 13.55 13 13 L 13 5 C 13 4.45 12.55 4 12 4 Z M 12 17 C 11.45 17 11 17.45 11 18 C 11 18.55 11.45 19 12 19 C 12.55 19 13 18.55 13 18 C 13 17.45 12.55 17 12 17 Z" 
                                  Fill="#F87171" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_ModalTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="{DynamicResource Loc_ModalSubtitle}" FontSize="12" Foreground="#888888" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Message Body -->
                    <TextBlock x:Name="ModalMessageText" 
                               Text="" 
                               TextWrapping="Wrap" 
                               FontSize="13" 
                               Foreground="#CCCCCC" 
                               LineHeight="19"
                               Margin="0,0,0,20" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Loc_ModalCancel}" 
                                Style="{StaticResource FluentToolButton}" 
                                Padding="16,7" 
                                Margin="0,0,10,0" 
                                Click="ModalCancel_Click" />

                        <Button Content="{DynamicResource Loc_ModalConfirm}" 
                                Style="{StaticResource FluentDangerButton}" 
                                Padding="16,7" 
                                Click="ModalConfirm_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
